# ---------------------------------------------------------------------------
# Runtime configuration. Copy to .env (set-up.sh does this for you).
# Scenario / algorithm parameters live in backend/config/settings.yaml.
# ---------------------------------------------------------------------------

# Backend (FastAPI / Uvicorn)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# SQLite by default; for PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://logistics:logistics@localhost:5432/logistics
DATABASE_URL=sqlite:///./backend/data/logistics.db
CORS_ORIGINS=*
SCENARIO_CONFIG=./backend/config/settings.yaml

# Optional scenario overrides (leave empty to use settings.yaml)
RANDOM_SEED=
ORDER_COUNT=
VEHICLE_COUNT=
AUTOSTART_SIMULATION=false
# The app always runs on the real Vijayawada road network (downloaded once by ./set-up.sh
# into backend/data/osm/). CITY_SOURCE=synthetic is used ONLY by the automated tests.
CITY_SOURCE=

# Map tiles under the roads. Empty = public CARTO light basemap – no key needed.
# Only if MAP_TILE_URL contains {apikey} is CARTO_API_KEY inserted into it.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
CARTO_API_KEY=

# Frontend (Vite dev server – proxies /api and /ws to the backend)
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Set only when the API is served from another origin
VITE_API_URL=
VITE_WS_URL=
